{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "cliente.essentiacountry.mx" }], "destination": "/lp" },
    { "source": "/", "has": [{ "type": "host", "value": "inversionista.essentiacountry.mx" }], "destination": "/lp" },
    { "source": "/a", "destination": "/lp" },
    { "source": "/b", "destination": "/lp" },
    { "source": "/", "destination": "/inicio" }
  ]
}
